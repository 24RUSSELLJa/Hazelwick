number = int(input("Enter a number: "))
found = False

if number % 3 == 0:
    print("Divisible by 3")
    found = True

if number % 5 == 0:
    print("Divisible by 5")
    found = True

if number % 7 == 0:
    print("Divisible by 7")
    found = True

if found == False:
    print("Not divisible by 3, 5, or 7")